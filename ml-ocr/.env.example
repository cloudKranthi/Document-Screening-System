# Environment Configuration for SIH OCR Microservice
APP_NAME="AI-Based Fake Identity & Document Screening - OCR Microservice"
APP_VERSION="1.0.0"
DEBUG=false

# OCR Engine: "auto", "tesseract", "paddleocr", "mock"
OCR_ENGINE="auto"

# Optional path override for Tesseract binary (Windows e.g. C:\Program Files\Tesseract-OCR\tesseract.exe)
TESSERACT_CMD=""

# Image Processing Limits
MAX_UPLOAD_SIZE_BYTES=15728640
MAX_IMAGE_DIMENSION=2400
MIN_IMAGE_DIMENSION=300

# Security & Compliance
MASK_PII_LOGS=true
